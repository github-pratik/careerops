# Copy to .env only for your own development/deployment; do not commit real values.
DATABASE_URL=postgres://careerops:replace-this@localhost:5432/careerops
ADMIN_PASSWORD=replace-with-at-least-16-random-characters
SESSION_SECRET=replace-with-at-least-32-random-characters
APP_ORIGIN=http://localhost:3100
PORT=3100
# Optional AI extraction. Review provider privacy settings before enabling.
GROQ_API_KEY=
ALLOW_PERSONAL_DATA_TO_GROQ=false

# Optional dedicated Gmail OAuth. Keep all values private; do not paste tokens in chat.
# Authorize gmail.readonly and gmail.send on a dedicated account, then configure
# the offline refresh token using Google's OAuth setup. No OAuth setup wizard is included yet.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_ADDRESS=
ALLOW_GMAIL=false
# Backup passphrase (20+ characters); keep separately from off-host encrypted backups.
BACKUP_PASSPHRASE=
