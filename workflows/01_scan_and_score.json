{
  "name": "01 – Scan & Score Jobs",
  "nodes": [
    {
      "id": "schedule-1",
      "name": "Every 6 Hours",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [240, 300],
      "parameters": {
        "rule": {
          "interval": [{ "field": "hours", "hoursInterval": 6 }]
        }
      }
    },
    {
      "id": "get-state-1",
      "name": "Get System State",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [460, 300],
      "parameters": {
        "operation": "getAll",
        "tableId": "system_state",
        "returnAll": true
      },
      "credentials": {
        "supabaseApi": { "id": "SupabaseAPI00001", "name": "Supabase API" }
      }
    },
    {
      "id": "parse-config-1",
      "name": "Parse Config",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [680, 300],
      "parameters": {
        "jsCode": "// Build a config object from key/value rows\nconst state = {};\nfor (const item of $input.all()) {\n  state[item.json.key] = item.json.value;\n}\n\nconst cfg = {\n  profile: JSON.parse(state.profile_json || '{}'),\n  companies: JSON.parse(state.h1b_companies_json || '[]'),\n  tier2Index: parseInt(state.tier2_index || '0', 10),\n  threshold: parseInt(state.score_threshold || '70', 10),\n  jsearchKey: state.jsearch_api_key || '',\n  jsearchDisabledUntil: state.jsearch_disabled_until || '2000-01-01',\n  telegramToken: state.telegram_token || '',\n  telegramChatId: state.telegram_chat_id || ''\n};\n\nconst disabledUntil = new Date(cfg.jsearchDisabledUntil);\nconst now = new Date();\ncfg.jsearchEnabled = cfg.jsearchKey && cfg.jsearchKey !== 'REPLACE_WITH_RAPIDAPI_KEY' && now > disabledUntil;\n\nreturn [{ json: cfg }];"
      }
    },
    {
      "id": "check-enabled-1",
      "name": "JSearch Enabled?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [900, 300],
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            {
              "id": "cond-1",
              "leftValue": "={{ $json.jsearchEnabled }}",
              "rightValue": true,
              "operator": { "type": "boolean", "operation": "true" }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "build-searches-1",
      "name": "Build Search List",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1120, 220],
      "parameters": {
        "jsCode": "const cfg = $input.first().json;\nconst roles = cfg.profile.roles || ['Software Engineer'];\nconst tier1 = cfg.companies.filter(c => c.tier === 1);\nconst tier2 = cfg.companies.filter(c => c.tier === 2);\nconst nextTier2 = tier2[cfg.tier2Index % tier2.length] || null;\n\nconst searches = [];\n// All tier-1 companies x each role\nfor (const co of tier1) {\n  for (const role of roles) {\n    searches.push({ company: co.search_name, role, tier: 1, cfg });\n  }\n}\n// One tier-2 company (round-robin)\nif (nextTier2) {\n  for (const role of roles) {\n    searches.push({ company: nextTier2.search_name, role, tier: 2, cfg });\n  }\n}\nreturn searches.map(s => ({ json: s }));"
      }
    },
    {
      "id": "loop-searches-1",
      "name": "Loop Searches",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [1340, 220],
      "parameters": { "batchSize": 1, "options": {} }
    },
    {
      "id": "jsearch-1",
      "name": "JSearch API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1560, 220],
      "onError": "continueRegularOutput",
      "parameters": {
        "method": "GET",
        "url": "https://jsearch.p.rapidapi.com/search",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "X-RapidAPI-Key", "value": "={{ $json.cfg.jsearchKey }}" },
            { "name": "X-RapidAPI-Host", "value": "jsearch.p.rapidapi.com" }
          ]
        },
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            { "name": "query", "value": "={{ $json.role }} {{ $json.company }}" },
            { "name": "page", "value": "1" },
            { "name": "num_pages", "value": "1" },
            { "name": "date_posted", "value": "week" }
          ]
        },
        "options": { "timeout": 15000 }
      }
    },
    {
      "id": "parse-jobs-1",
      "name": "Parse Job Results",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1780, 220],
      "parameters": {
        "jsCode": "const data = $input.first().json;\nconst jobs = data.data || [];\nconst prev = $('Loop Searches').first().json;\nconst cfg = prev.cfg;\n\nreturn jobs.map(j => ({\n  json: {\n    id: j.job_id,\n    company: j.employer_name,\n    title: j.job_title,\n    url: j.job_apply_link || j.job_google_link,\n    location: j.job_city ? `${j.job_city}, ${j.job_state}` : (j.job_country || 'Remote'),\n    source: 'jsearch',\n    posted_at: j.job_posted_at_datetime_utc ? j.job_posted_at_datetime_utc.slice(0,10) : null,\n    description: (j.job_description || '').slice(0, 3000),\n    cfg\n  }\n}));"
      }
    },
    {
      "id": "upsert-jobs-1",
