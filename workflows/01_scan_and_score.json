    {
      "id": "build-prompt-1",
      "name": "Build Score Prompt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [3100, 180],
      "parameters": {
        "jsCode": "const job = $input.first().json;\nconst cfg = $('Parse Config').first().json;\nconst profile = cfg.profile;\n\nconst prompt = `You are a job match scorer for a job seeker with the following profile:\n${JSON.stringify(profile, null, 2)}\n\nRate this job posting on a scale of 0-100 for match quality:\n- Title: ${job.title}\n- Company: ${job.company}\n- Location: ${job.location}\n\nScoring guide:\n90-100: Perfect match (exact role, H1B company, good location)\n70-89: Strong match (right domain, minor gaps)\n50-69: Decent match (related role or some gap)\n0-49: Weak match\n\nRespond ONLY with valid JSON: {\"score\": <number>, \"reason\": \"<one sentence>\"}`;\n\nreturn [{ json: { job, cfg, prompt, threshold: cfg.threshold } }];"
      }
    },
    {
      "id": "gemini-score-1",
      "name": "Score – Gemini",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [3320, 100],
      "onError": "continueErrorOutput",
      "parameters": {
        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-1.5-flash:generateContent",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googlePalmApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { contents: [{ parts: [{ text: $json.prompt }] }], generationConfig: { temperature: 0.1, maxOutputTokens: 200 } } }}",
        "options": { "timeout": 20000 }
      },
      "credentials": {
        "googlePalmApi": { "id": "PJKDW19fNu0t9njE", "name": "Google Gemini(PaLM) Api account" }
      }
    },
    {
      "id": "groq-score-1",
      "name": "Score – Groq",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [3320, 260],
      "onError": "continueErrorOutput",
      "parameters": {
        "method": "POST",
        "url": "https://api.groq.com/openai/v1/chat/completions",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "groqApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { model: 'llama-3.1-8b-instant', messages: [{ role: 'user', content: $('Build Score Prompt').first().json.prompt }], max_tokens: 200, temperature: 0.1 } }}",
        "options": { "timeout": 20000 }
      },
      "credentials": {
        "groqApi": { "id": "uPBmhptgAWdFHG4h", "name": "Groq account" }
      }
    },
    {
      "id": "cerebras-score-1",
      "name": "Score – Cerebras",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [3320, 420],
      "onError": "continueRegularOutput",
      "parameters": {
        "method": "POST",
        "url": "https://api.cerebras.ai/v1/chat/completions",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { model: 'llama3.1-8b', messages: [{ role: 'user', content: $('Build Score Prompt').first().json.prompt }], max_tokens: 200, temperature: 0.1 } }}",
        "options": { "timeout": 20000 }
      },
      "credentials": {
        "httpHeaderAuth": { "id": "cAm7WJVV2NJC5krO", "name": "Cerebras" }
      }
    },
    {
      "id": "extract-gemini-1",
      "name": "Extract Score (Gemini)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [3560, 100],
      "parameters": {
        "jsCode": "const resp = $input.first().json;\nconst text = resp.candidates?.[0]?.content?.parts?.[0]?.text || '';\ntry {\n  const m = text.match(/\\{[^}]+\\}/);\n  const parsed = JSON.parse(m ? m[0] : text);\n  return [{ json: { score: parsed.score || 0, reason: parsed.reason || '', source: 'gemini', job: $('Build Score Prompt').first().json.job, cfg: $('Build Score Prompt').first().json.cfg, threshold: $('Build Score Prompt').first().json.threshold } }];\n} catch(e) {\n  return [{ json: { score: 0, reason: 'parse error', source: 'gemini', job: $('Build Score Prompt').first().json.job, cfg: $('Build Score Prompt').first().json.cfg, threshold: $('Build Score Prompt').first().json.threshold } }];\n}"
      }
    },
    {
      "id": "extract-groq-1",
      "name": "Extract Score (Groq)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [3560, 260],
      "parameters": {
        "jsCode": "const resp = $input.first().json;\nconst text = resp.choices?.[0]?.message?.content || '';\ntry {\n  const m = text.match(/\\{[^}]+\\}/);\n  const parsed = JSON.parse(m ? m[0] : text);\n  return [{ json: { score: parsed.score || 0, reason: parsed.reason || '', source: 'groq', job: $('Build Score Prompt').first().json.job, cfg: $('Build Score Prompt').first().json.cfg, threshold: $('Build Score Prompt').first().json.threshold } }];\n} catch(e) {\n  return [{ json: { score: 0, reason: 'parse error', source: 'groq', job: $('Build Score Prompt').first().json.job, cfg: $('Build Score Prompt').first().json.cfg, threshold: $('Build Score Prompt').first().json.threshold } }];\n}"
      }
    },
    {
      "id": "extract-cerebras-1",
      "name": "Extract Score (Cerebras)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [3560, 420],
      "parameters": {
        "jsCode": "const resp = $input.first().json;\nconst text = resp.choices?.[0]?.message?.content || '';\ntry {\n  const m = text.match(/\\{[^}]+\\}/);\n  const parsed = JSON.parse(m ? m[0] : text);\n  return [{ json: { score: parsed.score || 0, reason: parsed.reason || '', source: 'cerebras', job: $('Build Score Prompt').first().json.job, cfg: $('Build Score Prompt').first().json.cfg, threshold: $('Build Score Prompt').first().json.threshold } }];\n} catch(e) {\n  return [{ json: { score: 0, reason: 'fallback default', source: 'cerebras', job: $('Build Score Prompt').first().json.job, cfg: $('Build Score Prompt').first().json.cfg, threshold: $('Build Score Prompt').first().json.threshold } }];\n}"
      }
    },
    {
      "id": "check-threshold-1",
      "name": "Score >= Threshold?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [3780, 260],
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            {
              "id": "thresh-1",
              "leftValue": "={{ $json.score }}",
              "rightValue": "={{ $json.threshold }}",
              "operator": { "type": "number", "operation": "gte" }
            }
          ],
          "combinator": "and"
        }
      }
    },
