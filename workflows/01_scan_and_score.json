    {
      "id": "send-telegram-1",
      "name": "Send Telegram",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [4220, 180],
      "parameters": {
        "method": "POST",
        "url": "=https://api.telegram.org/bot{{ $('Extract Score (Gemini)').first()?.json?.cfg?.telegramToken || $('Extract Score (Groq)').first()?.json?.cfg?.telegramToken || $('Extract Score (Cerebras)').first()?.json?.cfg?.telegramToken }}/sendMessage",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ {\n  chat_id: $json.cfg.telegramChatId,\n  text: `🎯 *Score: ${$('Check Threshold').first().json.score}/100* — ${$('Check Threshold').first().json.source}\\n\\n*${$('Check Threshold').first().json.job.title}*\\n🏢 ${$('Check Threshold').first().json.job.company}\\n📍 ${$('Check Threshold').first().json.job.location}\\n\\n_${$('Check Threshold').first().json.reason}_`,\n  parse_mode: 'Markdown',\n  reply_markup: {\n    inline_keyboard: [[\n      { text: '✅ YES – Apply', callback_data: `approve:${$('Check Threshold').first().json.job.id}` },\n      { text: '❌ NO – Skip', callback_data: `skip:${$('Check Threshold').first().json.job.id}` }\n    ]]\n  }\n} }}",
        "options": {}
      }
    },
    {
      "id": "log-telegram-1",
      "name": "Log Telegram Msg",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [4440, 180],
      "parameters": {
        "method": "POST",
        "url": "https://kwxaxpjxdquuxetlyoly.supabase.co/rest/v1/approvals",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Imt3eGF4cGp4ZHF1dXhldGx5b2x5Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3Nzc4MjExNTQsImV4cCI6MjA5MzM5NzE1NH0.d12qP6mvBUqL3vhBjqxlO-k0ewsU0YQDAM54QpBDbO4" },
            { "name": "Authorization", "value": "Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Imt3eGF4cGp4ZHF1dXhldGx5b2x5Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3Nzc4MjExNTQsImV4cCI6MjA5MzM5NzE1NH0.d12qP6mvBUqL3vhBjqxlO-k0ewsU0YQDAM54QpBDbO4" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
