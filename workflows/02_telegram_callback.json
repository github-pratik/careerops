    {
      "id": "parse-callback-1",
      "name": "Parse Callback",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [460, 300],
      "parameters": {
        "jsCode": "const body = $input.first().json.body;\nconst cbQuery = body.callback_query;\n\nif (!cbQuery) {\n  return [{ json: { valid: false, reason: 'no callback_query' } }];\n}\n\nconst data = cbQuery.data || '';\nconst parts = data.split(':');\nconst action = parts[0]; // 'approve' or 'skip'\nconst jobId = parts[1] || '';\n\nreturn [{\n  json: {\n    valid: true,\n    action,\n    jobId,\n    callbackQueryId: cbQuery.id,\n    chatId: cbQuery.message?.chat?.id,\n    messageId: cbQuery.message?.message_id,\n    userFirstName: cbQuery.from?.first_name || 'you'\n  }\n}];"
      }
    },
    {
      "id": "check-valid-1",
      "name": "Valid Callback?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [680, 300],
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            {
              "id": "valid-1",
              "leftValue": "={{ $json.valid }}",
              "rightValue": true,
              "operator": { "type": "boolean", "operation": "true" }
            }
          ],
          "combinator": "and"
        }
      }
    },
