    {
      "id": "answer-callback-1",
      "name": "Answer Callback Query",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1780, 240],
      "parameters": {
        "jsCode": "const cb = $('Parse Callback').first().json;\nconst action = cb.action;\nconst tgConfig = $('Get Telegram Config').first().json;\nconst token = tgConfig.value || '';\n\n// Acknowledge the callback query so the loading spinner stops\nconst ackUrl = `https://api.telegram.org/bot${token}/answerCallbackQuery`;\nconst text = action === 'approve' ? '✅ Added to apply list!' : '❌ Skipped!';\n\n// Build both requests to run\nreturn [{\n  json: {\n    ackUrl,\n    ackBody: { callback_query_id: cb.callbackQueryId, text, show_alert: false },\n    editUrl: `https://api.telegram.org/bot${token}/editMessageReplyMarkup`,\n    editBody: { chat_id: cb.chatId, message_id: cb.messageId, reply_markup: { inline_keyboard: [] } }\n  }\n}];"
      }
    },
