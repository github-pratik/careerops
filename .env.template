# SmartJob Hunter — Environment Variables
# Copy to .env and fill in real values before running docker compose up

# ── Domain ──────────────────────────────────────────────────────────────────
# No custom domain needed — use your Droplet IP + nip.io for free HTTPS
# Format: YOUR_DROPLET_IP.nip.io  (e.g. 143.110.5.200.nip.io)
# nip.io automatically resolves to your IP — no DNS setup, no registration
DOMAIN=YOUR_DROPLET_IP.nip.io

# ── Supabase (use DIRECT connection, port 5432 — NOT the pooler port 6543) ──
# Find in: Supabase Dashboard → Project Settings → Database → Connection string (URI)
# Example: postgresql://postgres:PASSWORD@db.XXXXX.supabase.co:5432/postgres
SUPABASE_DB_HOST=db.YOURPROJECT.supabase.co
SUPABASE_DB_PASSWORD=your-supabase-db-password
# Full connection string (for reference / direct psql use)
SUPABASE_CONNECTION_STRING=postgresql://postgres:your-supabase-db-password@db.YOURPROJECT.supabase.co:5432/postgres

# ── n8n ──────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
N8N_ENCRYPTION_KEY=replace_with_openssl_rand_hex_32

# ── Telegram ─────────────────────────────────────────────────────────────────
# Get bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
# Your personal Telegram chat ID (message @userinfobot to get it)
TELEGRAM_CHAT_ID=987654321
# Webhook secret — generate with: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=replace_with_openssl_rand_hex_32

# ── Resend ───────────────────────────────────────────────────────────────────
# Get from resend.com → API Keys. Use onboarding@resend.dev as sender during testing.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Sender address — use onboarding@resend.dev for testing (no domain verification needed)
RESEND_FROM=onboarding@resend.dev
RESEND_TO=your.email@gmail.com

# ── Job Source APIs ──────────────────────────────────────────────────────────
# JSearch (RapidAPI) — free tier: 200 req/month
# Get from rapidapi.com/letscrape-6baf62026ea8/api/jsearch
JSEARCH_API_KEY=your_rapidapi_key_here

# Adzuna — free developer tier
# Register at developer.adzuna.com
ADZUNA_APP_ID=your_adzuna_app_id
ADZUNA_APP_KEY=your_adzuna_app_key

# Gemini Flash — free tier: 1.5M tokens/day, 15 req/min
# Get from aistudio.google.com → Get API key
GEMINI_API_KEY=AIzaSy_your_gemini_api_key
